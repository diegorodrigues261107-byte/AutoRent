digraph G {graph [label="Diagrama de Classes — AutoRent",labelloc=t,fontsize=18,rankdir=LR,fontname="Arial",splines=polyline];node [shape=record,fontname="Arial",style=filled,fillcolor="#e8f2ff",color="#7795b7"];Cliente[label="{Cliente|id: int\lnome: string\lcpf: string\lrg: string\lendereco: string\lprofissao: string\l}"];Empregador[label="{Empregador|entidade: string\lrendimento: number\l}"];Automovel[label="{Automovel|id: int\lmatricula: string\lano: int\lmarca: string\lmodelo: string\lplaca: string\lproprietarioTipo: string\lproprietarioId: int\l}"];Pedido[label="{PedidoAluguel|id: int\lclienteId: int\lautomovelId: int\ldataInicio: date\ldataFim: date\lstatus: string\lparecer: string\lagenteId: int\l}"];Agente[label="{Agente|id: int\lnome: string\ltipo: empresa/banco\l}"];Contrato[label="{Contrato|id: int\lpedidoId: int\ltipo: aluguel/credito\lbancoId: int?\lvalor: number\l}"];Cliente->Empregador[label="1 para 0..3",arrowhead=odiamond];Cliente->Pedido[label="1 para 0..*",arrowhead=none];Automovel->Pedido[label="1 para 0..*",arrowhead=none];Agente->Pedido[label="avalia 0..*",arrowhead=none];Pedido->Contrato[label="1 para 0..1",arrowhead=none];Agente->Contrato[label="banco opcional",style=dashed];}